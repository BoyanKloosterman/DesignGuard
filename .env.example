# Kopieer naar .env naast de executable of zet deze variabelen in je systeem-omgeving.
# Geen echte wachtwoorden of productie-URI's in git.

DESIGNGUARD_MONGODB_CONNECTION_STRING=mongodb://localhost:27017
DESIGNGUARD_MONGODB_DATABASE=designguard
DESIGNGUARD_MONGODB_APPNAME=DesignGuard
DESIGNGUARD_ENVIRONMENT=Development

# Optioneel:
# DESIGNGUARD_MONGODB_TIMEOUT_SECONDS=15
# DESIGNGUARD_MONGODB_TLS=false
# DESIGNGUARD_MONGODB_READ_PREFERENCE=primary
#
# .env wordt alleen gelezen als DESIGNGUARD_ENVIRONMENT=Development in dit bestand staat,
# of als DESIGNGUARD_LOAD_DOTENV=1 al in de process-omgeving staat vóór start.
