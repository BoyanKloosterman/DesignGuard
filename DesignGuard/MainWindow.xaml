<Window x:Class="DesignGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:DesignGuard.Converters"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="DesignGuard v6 — Security-by-design werkbench"
        Height="820" Width="1320"
        Background="{DynamicResource DgBrush.Window}"
        Foreground="{DynamicResource DgBrush.TextPrimary}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:IntEqualsToVisibilityConverter x:Key="IntEqVis" />
        <conv:StringEqualsToVisibilityConverter x:Key="StrEqVis" />
    </Window.Resources>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusMessage}" />
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="328" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource DgBrush.Sidebar}"
                    BorderBrush="{DynamicResource DgBrush.Border}" BorderThickness="0,0,1,0"
                    Padding="{DynamicResource DgThickness.SidebarPad}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="DesignGuard" Style="{StaticResource DgText.SectionLabel}" FontSize="11"
                                   Foreground="{DynamicResource DgBrush.TextMuted}" Margin="0,0,0,2" />
                        <TextBlock Text="Projecten" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource DgBrush.TextPrimary}" />
                        <Button Content="Nieuw project" Style="{StaticResource DgButton.Accent}"
                                Command="{Binding NewProjectCommand}" />
                        <Button Content="Wizard" Style="{StaticResource DgButton.Toolbar}"
                                Command="{Binding OpenProjectWizardCommand}" />
                        <Button Content="Opslaan" Style="{StaticResource DgButton.Toolbar}"
                                Command="{Binding SaveProjectCommand}" />
                        <Button Content="Verwijderen" Style="{StaticResource DgButton.Toolbar}"
                                Command="{Binding DeleteProjectCommand}" />
                        <Button Content="Demoproject" Style="{StaticResource DgButton.Toolbar}"
                                Command="{Binding EnsureDemoCommand}" Margin="0,0,0,12" />
                        <TextBlock Text="Werkruimte" Style="{StaticResource DgText.SectionLabel}" />
                        <ListBox Style="{StaticResource DgNavListBox}" MinHeight="220"
                                 SelectedIndex="{Binding NavSection, Mode=TwoWay}">
                            <ListBoxItem Content="Dashboard" />
                            <ListBoxItem Content="Ontwerp" />
                            <ListBoxItem Content="Dreigingen" />
                            <ListBoxItem Content="Eisen" />
                            <ListBoxItem Content="Controls" />
                            <ListBoxItem Content="Beslissingen" />
                            <ListBoxItem Content="Review" />
                            <ListBoxItem Content="Traceability" />
                            <ListBoxItem Content="Export" />
                            <ListBoxItem Content="Instellingen" />
                            <ListBoxItem Content="App security review" />
                        </ListBox>
                        <TextBlock Text="Weergave" Style="{StaticResource DgText.SectionLabel}" Margin="0,12,0,4" />
                        <TextBlock Text="Thema" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                        <ComboBox Margin="0,2,0,8" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding UiTheme}" />
                        <TextBlock Text="Uitlegniveau" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}"
                                   ToolTip="Beginner: korte hulp en minder jargon in beeld. Advanced: alle technische velden." />
                        <ComboBox Margin="0,2,0,8" ItemsSource="{Binding DetailLevelOptions}"
                                  SelectedItem="{Binding DetailLevel}" />
                        <TextBlock Text="Dichtheid" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                        <ComboBox Margin="0,2,0,0" ItemsSource="{Binding UiDensityOptions}"
                                  SelectedItem="{Binding UiDensity}" />
                    </StackPanel>
                    <ListBox DockPanel.Dock="Bottom" Margin="0,12,0,0" MinHeight="100"
                             Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding ProjectList}"
                             SelectedItem="{Binding SelectedProjectSummary}"
                             DisplayMemberPath="Name">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="{DynamicResource DgThickness.PageMargin}">
                <!-- Dashboard -->
                <ScrollViewer Visibility="{Binding NavSection, Converter={StaticResource IntEqVis}, ConverterParameter=0}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Dashboard" Style="{StaticResource DgText.Title}" />
                        <TextBlock Style="{StaticResource DgText.Muted}" Margin="0,8,0,12" FontSize="{DynamicResource DgFontSize.Subtitle}"
                                   Text="Overzicht van je ontwerp en volgende stappen. DesignGuard helpt structureren — geen formele compliance-bewijs." />
                        <Border Style="{StaticResource DgCard}" Margin="0,0,0,16"
                                Visibility="{Binding HasNoProject, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Welkom" FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource DgText.Muted}" FontSize="12"
                                           Text="Kies een project hiernaast, maak een nieuw project of start met het demoproject. Daarna: vul 'Ontwerp' in en werk naar dreigingen, eisen en export." TextWrapping="Wrap" />
                                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextSecondary}" TextWrapping="Wrap"
                                           Text="1) Project kiezen of aanmaken · 2) Systeem en componenten · 3) Analyse vernieuwen · 4) PDF of Markdown export" />
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Snapshot (lokaal)" Style="{StaticResource DgButton.Toolbar}"
                                    Command="{Binding SaveProjectSnapshotCommand}" />
                            <Button Content="Control-bibliotheek" Style="{StaticResource DgButton.Toolbar}"
                                    Command="{Binding ApplyControlLibraryCommand}" />
                        </WrapPanel>
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Style="{StaticResource DgCard}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Openstaande dreigingen" Style="{StaticResource DgText.Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding OpenThreatCount}" FontSize="26" FontWeight="Bold"
                                               Foreground="{DynamicResource DgBrush.TextPrimary}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DgCard}" Margin="8,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Afgewezen / beperkt risico" Style="{StaticResource DgText.Muted}" FontSize="11"
                                               ToolTip="Dreigingen met status opgelost of geaccepteerd (met rationale)." />
                                    <TextBlock Text="{Binding MitigatedThreatCount}" FontSize="26" FontWeight="Bold"
                                               Foreground="{DynamicResource DgBrush.TextPrimary}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DgCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Eisen in uitvoering" Style="{StaticResource DgText.Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding OpenRequirementCount}" FontSize="26" FontWeight="Bold"
                                               Foreground="{DynamicResource DgBrush.TextPrimary}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DgCard}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Eisen afgerond" Style="{StaticResource DgText.Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding ImplementedRequirementCount}" FontSize="26" FontWeight="Bold"
                                               Foreground="{DynamicResource DgBrush.TextPrimary}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="Start met een sjabloon" Style="{StaticResource DgText.SectionLabel}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource DgText.Muted}" FontSize="11" Margin="0,0,0,8"
                                   Text="Sjablonen vullen het ontwerp voorbeeldgewijs; daarna kun je alles aanpassen." />
                        <ItemsControl ItemsSource="{Binding TemplateList}" Margin="0,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Title}" Style="{StaticResource DgButton.Toolbar}"
                                            HorizontalAlignment="Left"
                                            ToolTip="{Binding Description}"
                                            Command="{Binding DataContext.ApplyTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Key}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Ontwerp -->
                <ScrollViewer AutomationProperties.AutomationId="OntwerpDesignScroll"
                              Visibility="{Binding NavSection, Converter={StaticResource IntEqVis}, ConverterParameter=1}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Systeemontwerp" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <GroupBox Header="Project">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Naam" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding EditorProjectName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Text="Beschrijving" Margin="0,8,0,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Height="56" TextWrapping="Wrap" AcceptsReturn="True"
                                         Text="{Binding EditorProjectDescription, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Systeemcontext" Margin="0,8,0,0">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Systeemnaam" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding EditorSystemName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Text="Type" Margin="0,8,0,0" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                          ItemsSource="{Binding SystemTypeOptions}" SelectedItem="{Binding EditorSystemType}" />
                                <TextBlock Grid.Row="2" Text="Deployment" Margin="0,8,0,0" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                          ItemsSource="{Binding DeploymentContextOptions}" SelectedItem="{Binding EditorDeploymentContext}" />
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                    <CheckBox Content="Internetblootstelling" IsChecked="{Binding FlagInternetExposed}" />
                                    <CheckBox Content="Logging / monitoring aanwezig" IsChecked="{Binding FlagLoggingMonitoring}" />
                                    <CheckBox Content="Bedrijfskritisch" IsChecked="{Binding FlagCriticalBusiness}" />
                                    <CheckBox Content="Persoonsgegevens" IsChecked="{Binding FlagPersonalData}" />
                                    <CheckBox Content="Authenticatie" IsChecked="{Binding FlagAuth}" />
                                    <CheckBox Content="Adminfunctionaliteit" IsChecked="{Binding FlagAdmin}" />
                                    <CheckBox Content="Externe API's" IsChecked="{Binding FlagExternalApi}" />
                                    <CheckBox Content="Bestandsupload" IsChecked="{Binding FlagUpload}" />
                                    <CheckBox Content="Gevoelige opslag" IsChecked="{Binding FlagSensitiveStorage}" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Trust boundaries" Margin="0,8,0,0">
                            <StackPanel Margin="8">
                                <Button Content="Toevoegen" HorizontalAlignment="Left" Command="{Binding AddTrustBoundaryCommand}" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding TrustBoundaries}" AutoGenerateColumns="False" CanUserAddRows="False" Height="120" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Naam" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTextColumn Header="Omschrijving" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                        <DataGridTextColumn Header="Kleur" Binding="{Binding ColorHint, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <DataGridTemplateColumn Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Verwijder"
                                                            Command="{Binding DataContext.RemoveTrustBoundaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Componenten" Margin="0,8,0,0">
                            <StackPanel Margin="8">
                                <Button Content="Component toevoegen" HorizontalAlignment="Left" Command="{Binding AddComponentCommand}" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent}" AutoGenerateColumns="False"
                                          CanUserAddRows="False" HeadersVisibility="Column" Height="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Naam" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTextColumn Header="Tag" Binding="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <DataGridCheckBoxColumn Header="Entry" Binding="{Binding IsEntryPoint}" Width="50" />
                                        <DataGridTextColumn Header="Boundary (naam)" Binding="{Binding TrustBoundaryName, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                        <DataGridTextColumn Header="Data" Binding="{Binding DataSensitivity, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <DataGridTextColumn Header="Notities" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTemplateColumn Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Verwijder"
                                                            Command="{Binding DataContext.RemoveComponentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Datastromen" Margin="0,8,0,0">
                            <StackPanel Margin="8">
                                <Button Content="Stroom toevoegen" HorizontalAlignment="Left" Command="{Binding AddDataFlowCommand}" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding DataFlows}" AutoGenerateColumns="False" CanUserAddRows="False" Height="140">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Van" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.Components, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding From, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Naar" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.Components, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding To, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTemplateColumn Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Verwijder"
                                                            Command="{Binding DataContext.RemoveDataFlowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Rollen" Margin="0,8,0,0">
                            <StackPanel Margin="8">
                                <Button Content="Rol toevoegen" HorizontalAlignment="Left" Command="{Binding AddRoleCommand}" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding Roles}" AutoGenerateColumns="False" CanUserAddRows="False" Height="100">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Naam" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTextColumn Header="Omschrijving" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                        <DataGridTemplateColumn Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Verwijder"
                                                            Command="{Binding DataContext.RemoveRoleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Assets" Margin="0,8,0,0">
                            <StackPanel Margin="8">
                                <Button Content="Asset toevoegen" Command="{Binding AddAssetCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding Assets}" AutoGenerateColumns="False" CanUserAddRows="False" Height="100">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Naam" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTextColumn Header="Classificatie" Binding="{Binding Classification, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                        <DataGridTextColumn Header="Gevoeligheid" Binding="{Binding Sensitivity, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                        <DataGridTemplateColumn Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Verwijder" Command="{Binding DataContext.RemoveAssetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Ingangen (entry points)" Margin="0,8,0,0">
                            <StackPanel Margin="8">
                                <Button Content="Ingang toevoegen" Command="{Binding AddEntryPointRowCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding EntryPoints}" AutoGenerateColumns="False" CanUserAddRows="False" Height="100">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Naam" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTextColumn Header="Component-Id" Binding="{Binding RelatedComponentId, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                        <DataGridTextColumn Header="Notities" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTemplateColumn Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Verwijder" Command="{Binding DataContext.RemoveEntryPointRowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Gevoelige data (categorie)" Margin="0,8,0,0">
                            <StackPanel Margin="8">
                                <Button Content="Rij toevoegen" Command="{Binding AddSensitiveDataRowCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding SensitiveDataRows}" AutoGenerateColumns="False" CanUserAddRows="False" Height="100">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Naam" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTextColumn Header="Categorie" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                        <DataGridTextColumn Header="Opslag" Binding="{Binding StorageLocation, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTextColumn Header="Comp-Id" Binding="{Binding RelatedComponentId, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <DataGridTemplateColumn Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Verwijder" Command="{Binding DataContext.RemoveSensitiveDataRowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Architectuurdiagram" Margin="0,8,0,0">
                            <StackPanel Margin="8">
                                <TextBlock Margin="0,0,0,6" Style="{StaticResource DgText.Muted}" FontSize="11" TextWrapping="Wrap"
                                           Text="Tip: groene rand = ingang, oranje streep = gevoelige data. Trust boundary = vertrouwensgrens tussen twee omgevingen (bijv. internet vs intern)." />
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Zoom −" Style="{StaticResource DgButton.Toolbar}" Command="{Binding DiagramZoomOutCommand}" />
                                    <Button Content="100%" Style="{StaticResource DgButton.Toolbar}" Command="{Binding DiagramFitToScreenCommand}" />
                                    <Button Content="Zoom +" Style="{StaticResource DgButton.Toolbar}" Command="{Binding DiagramZoomInCommand}" />
                                    <CheckBox Content="Raster" IsChecked="{Binding DiagramShowGrid}" VerticalAlignment="Center" Margin="0,0,12,6" />
                                    <CheckBox Content="Trust boundaries" IsChecked="{Binding DiagramOverlayTrustBoundaries}" VerticalAlignment="Center" Margin="0,0,12,6" />
                                    <CheckBox Content="Gevoelige data" IsChecked="{Binding DiagramOverlaySensitiveData}" VerticalAlignment="Center" Margin="0,0,12,6" />
                                    <CheckBox Content="Dreiging → component" IsChecked="{Binding DiagramOverlayThreatLinks}" VerticalAlignment="Center" Margin="0,0,0,6" />
                                </WrapPanel>
                                <Border BorderBrush="{DynamicResource DgBrush.Border}" BorderThickness="1" Height="420"
                                        Background="{DynamicResource DgBrush.DiagramCanvas}" CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiagramShowGrid}" Value="True">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <DrawingBrush TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute" Opacity="0.5">
                                                                <DrawingBrush.Drawing>
                                                                    <GeometryDrawing>
                                                                        <GeometryDrawing.Geometry>
                                                                            <GeometryGroup>
                                                                                <LineGeometry StartPoint="0,22" EndPoint="22,0" />
                                                                            </GeometryGroup>
                                                                        </GeometryDrawing.Geometry>
                                                                        <GeometryDrawing.Pen>
                                                                            <Pen Brush="#E2E8F0" Thickness="0.6" />
                                                                        </GeometryDrawing.Pen>
                                                                    </GeometryDrawing>
                                                                </DrawingBrush.Drawing>
                                                            </DrawingBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Grid Width="{Binding DiagramContentWidth}" Height="{Binding DiagramContentHeight}"
                                              Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                            <Grid.LayoutTransform>
                                                <ScaleTransform ScaleX="{Binding DiagramZoom}" ScaleY="{Binding DiagramZoom}" />
                                            </Grid.LayoutTransform>
                                            <ItemsControl ItemsSource="{Binding DiagramTrustOverlays}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="10" BorderThickness="2"
                                                                BorderBrush="{Binding Color}" Background="#08FFFFFF" SnapsToDevicePixels="True" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding DiagramLines}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="0" />
                                                        <Setter Property="Canvas.Top" Value="0" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Canvas>
                                                            <!-- Alleen stroke op curve: geen lint-vulling -->
                                                            <Path Data="{Binding CurvePath}" Stroke="#64748B" StrokeThickness="1"
                                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Fill="Transparent" SnapsToDevicePixels="True" Opacity="0.92" />
                                                            <Path Data="{Binding ArrowPath}" Fill="#475569" Stroke="#334155" StrokeThickness="0.35"
                                                                  StrokeLineJoin="Miter" SnapsToDevicePixels="True" />
                                                            <Border Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                                                    Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                                                                    CornerRadius="3" Padding="4,2">
                                                                <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#1E293B"
                                                                           TextWrapping="Wrap" MaxWidth="200" />
                                                            </Border>
                                                        </Canvas>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding DiagramNodes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="196" Height="64" CornerRadius="8" BorderThickness="1.5" Padding="8,6,8,6"
                                                                Background="White" SnapsToDevicePixels="True" MouseLeftButtonDown="DiagramNode_MouseDown">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#2D3748" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#C53030" />
                                                                            <Setter Property="BorderThickness" Value="2.5" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsLinkedHighlight}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#B83280" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.Tag>
                                                                <Binding Path="ComponentId" />
                                                            </Border.Tag>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="4" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" CornerRadius="2,0,0,2" Margin="0,0,6,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#CBD5E1" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShowSensitiveStripe}" Value="True">
                                                                                    <Setter Property="Background" Value="#D69E2E" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsEntryPoint}" Value="True">
                                                                                    <Setter Property="Background" Value="#38A169" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" Foreground="#1A202C" />
                                                                    <TextBlock Text="{Binding Tag}" Foreground="#718096" FontSize="10" />
                                                                    <TextBlock Text="{Binding DataSensitivity}" FontSize="9" Foreground="#4A5568" Visibility="{Binding ShowSensitiveStripe, Converter={StaticResource BoolToVis}}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                                <Button Content="Diagram verversen" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding RegenerateFromDesignCommand}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Dreigingen -->
                <DockPanel Visibility="{Binding NavSection, Converter={StaticResource IntEqVis}, ConverterParameter=2}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Dreigingen (threat model)" Style="{StaticResource DgText.Title}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource DgText.Muted}" FontSize="11" TextWrapping="Wrap"
                                   Text="Wat kan misgaan met jouw ontwerp? STRIDE groepeert soorten risico (bijv. spoofing, datalek). Kies een item voor uitleg en mitigaties in het rechterpaneel."
                                   Visibility="{Binding DetailLevel, Converter={StaticResource StrEqVis}, ConverterParameter=Beginner}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Analyse vernieuwen" Command="{Binding RegenerateFromDesignCommand}" Margin="0,0,8,8" />
                            <Button Content="Handmatige dreiging" Command="{Binding AddCustomThreatCommand}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Zoek:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="200" Text="{Binding ThreatFilterText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Sorteer:" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <ComboBox x:Name="ThreatSortBox" Width="120" SelectionChanged="ThreatSortBox_OnSelectionChanged">
                                <ComboBoxItem Content="Severity" Tag="Severity" />
                                <ComboBoxItem Content="Status" Tag="Status" />
                                <ComboBoxItem Content="Category" Tag="Category" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding FilteredThreats}" SelectedItem="{Binding SelectedThreat}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                    <TextBlock FontSize="11" Foreground="Gray">
                                        <Run Text="{Binding StrideCategory, Mode=OneWay}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Severity, Mode=OneWay}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Status, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Eisen -->
                <DockPanel Visibility="{Binding NavSection, Converter={StaticResource IntEqVis}, ConverterParameter=3}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Security-eisen" Style="{StaticResource DgText.Title}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource DgText.Muted}" FontSize="11" TextWrapping="Wrap"
                                   Text="Eisen vertellen wat je systeem moet kunnen of moet afdwingen (bijv. logging, toegang). Ze zijn gekoppeld aan dreigingen en controls."
                                   Visibility="{Binding DetailLevel, Converter={StaticResource StrEqVis}, ConverterParameter=Beginner}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Analyse vernieuwen" Command="{Binding RegenerateFromDesignCommand}" Margin="0,0,8,8" />
                            <Button Content="Handmatige eis" Command="{Binding AddCustomRequirementCommand}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Zoek:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="200" Text="{Binding RequirementFilterText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Sorteer:" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <ComboBox x:Name="ReqSortBox" Width="120" SelectionChanged="ReqSortBox_OnSelectionChanged">
                                <ComboBoxItem Content="Priority" Tag="Priority" />
                                <ComboBoxItem Content="Status" Tag="Status" />
                                <ComboBoxItem Content="Category" Tag="Category" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding FilteredRequirements}" SelectedItem="{Binding SelectedRequirement}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="Gray" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Controls -->
                <ScrollViewer Visibility="{Binding NavSection, Converter={StaticResource IntEqVis}, ConverterParameter=4}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Controls / maatregelen" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"
                                   Text="Bibliotheek is regelgebaseerd. Gebruik 'Control-bibliotheek' of vernieuw de analyse om suggesties toe te voegen." />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Handmatige control" Command="{Binding AddControlCommand}" Margin="0,0,8,8" />
                            <Button Content="Pas bibliotheek toe" Command="{Binding ApplyControlLibraryCommand}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding Controls}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="200" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Titel" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTextColumn Header="Categorie" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Tags" Binding="{Binding SourceTags, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTemplateColumn Header="Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.ControlLifecycleStatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Dreiging (stable id)" Binding="{Binding LinkedThreatStableId, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Eisen (ids, komma)" Binding="{Binding LinkedRequirementStableIds, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Library id" Binding="{Binding LibraryDefinitionId, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="120" />
                                <DataGridTextColumn Header="Uitleg" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTextColumn Header="Implementatie" Binding="{Binding ImplementationGuidance, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Verwijder" Command="{Binding DataContext.RemoveControlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Beslissingen -->
                <ScrollViewer Visibility="{Binding NavSection, Converter={StaticResource IntEqVis}, ConverterParameter=5}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Beslissingen en aannames" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Open issues / vervolg" FontWeight="SemiBold" />
                        <TextBox Text="{Binding OpenIssuesSummary, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,16" />
                        <TextBlock Text="Design-notities (soort als tekst: Assumption, Decision, ...)" FontWeight="SemiBold" />
                        <Button Content="Notitie toevoegen" HorizontalAlignment="Left" Command="{Binding AddDesignNoteCommand}" Margin="0,8,0,8" />
                        <DataGrid ItemsSource="{Binding DesignNotes}" AutoGenerateColumns="False" CanUserAddRows="False" Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Soort" Binding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                <DataGridTextColumn Header="Titel" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Beschrijving" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Verwijder" Command="{Binding DataContext.RemoveDesignNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Project-snapshots (bewaar met Opslaan)" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <Button Content="Snapshot vastleggen" Command="{Binding SaveProjectSnapshotCommand}" HorizontalAlignment="Left" Margin="0,8,0,8" />
                        <DataGrid ItemsSource="{Binding Snapshots}" AutoGenerateColumns="False" CanUserAddRows="False" Height="100">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Naam" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTextColumn Header="UTC" Binding="{Binding CreatedAtUtc, StringFormat=u}" IsReadOnly="True" Width="*" />
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Verwijder" Command="{Binding DataContext.RemoveSnapshotRowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Review board -->
                <ScrollViewer Visibility="{Binding NavSection, Converter={StaticResource IntEqVis}, ConverterParameter=6}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Review board" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"
                                   Text="Lichte workflow: koppel stable id's van dreigingen/eisen/controls of noteer open vragen." />
                        <Button Content="Review-item" Command="{Binding AddReviewItemRowCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding ReviewItems}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="220">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Onderwerp" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.ReviewSubjectKindOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding SubjectKind, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Stable id" Binding="{Binding SubjectStableId, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Titel" Binding="{Binding SubjectTitle, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTemplateColumn Header="Status" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.ReviewWorkflowStatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Eigenaar" Binding="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Notities" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Verwijder" Command="{Binding DataContext.RemoveReviewItemRowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Traceability -->
                <DockPanel Visibility="{Binding NavSection, Converter={StaticResource IntEqVis}, ConverterParameter=7}">
                    <TextBlock DockPanel.Dock="Top" Text="Traceability" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding TraceabilityText}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" BorderThickness="0" />
                    </ScrollViewer>
                </DockPanel>

                <!-- Export -->
                <DockPanel Visibility="{Binding NavSection, Converter={StaticResource IntEqVis}, ConverterParameter=8}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Export" FontSize="22" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="PDF" Command="{Binding ExportPdfCommand}" Margin="0,0,8,8" />
                            <Button Content="HTML (print)" Command="{Binding ExportPrintFriendlyHtmlCommand}" Margin="0,0,8,8" />
                            <Button Content="Markdown" Command="{Binding ExportMarkdownCommand}" Margin="0,0,8,8" />
                            <Button Content="Tekst" Command="{Binding ExportPlainTextCommand}" Margin="0,0,8,8" />
                            <Button Content="HTML (kort)" Command="{Binding ExportHtmlCommand}" Margin="0,0,8,8" />
                            <Button Content="JSON" Command="{Binding ExportStructuredJsonCommand}" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                    <TextBox Text="{Binding ExportPreview}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" />
                </DockPanel>

                <ScrollViewer Visibility="{Binding NavSection, Converter={StaticResource IntEqVis}, ConverterParameter=9}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Instellingen" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,16"
                                   Text="Knowledge packs: schakel bron-modules in/uit. Uitgeschakelde packs worden niet gebruikt voor nieuwe attributie. Standaarden wijzigen — herzie packs periodiek." />
                        <TextBlock Text="Knowledge packs" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding KnowledgePackRows}" Margin="0,8,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,8" Background="White">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                        <Run Text="{Binding DisplayLabel, Mode=OneWay}" />
                                                        <Run Text=" (" /><Run Text="{Binding PackId, Mode=OneWay}" /><Run Text=")" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Margin="20,4,0,0" FontSize="10" Foreground="Gray" TextWrapping="Wrap">
                                                <Run Text="Versie: " /><Run Text="{Binding VersionLabel, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Margin="20,2,0,0" FontSize="10" Foreground="#475569" TextWrapping="Wrap" Text="{Binding SourceName, Mode=OneWay}" />
                                            <TextBlock Margin="20,4,0,0" FontSize="10" Foreground="DarkOrange" TextWrapping="Wrap"
                                                       Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}">
                                                Pack is ouder dan de ingestelde waarschuwingsperiode — controleer bron en update pack.
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Database / MongoDB" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,4,0,12"
                                   Text="Projectdata staat in MongoDB. Configureer omgevingsvariabelen (of .env in Development) — zie CONFIGURATION.md en DEPLOYMENT.md." />
                        <TextBlock FontSize="11" Foreground="#334155">
                            <Run Text="Omgeving: " /><Run Text="{Binding MongoDiagEnvironment, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="Omgevingsvariabelen" FontSize="11" Foreground="#334155" Margin="0,4,0,0" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#334155" Text="{Binding MongoDiagEnvVars}" />
                        <TextBlock FontSize="11" Foreground="#334155" Margin="0,4,0,0">
                            <Run Text="Database-naam: " /><Run Text="{Binding MongoDiagDatabase, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#334155" Margin="0,4,0,0">
                            <Run Text="ApplicationName: " /><Run Text="{Binding MongoDiagAppName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="Optionele opties" FontSize="11" Foreground="#334155" Margin="0,4,0,0" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#334155" Text="{Binding MongoDiagOptions}" />
                        <TextBlock Text="Connection (gemaskeerd)" FontSize="11" Foreground="#334155" Margin="0,4,0,0" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" FontFamily="Consolas" Foreground="#334155"
                                   Text="{Binding MongoDiagMaskedConnection}" />
                        <TextBlock Text="{Binding MongoDiagWarning}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                   Foreground="DarkOrange"
                                   Visibility="{Binding MongoDiagHasConfigWarning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding MongoDiagPing}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                   Foreground="#0F766E" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Verbinding testen (ping)" Command="{Binding TestMongoConnectionCommand}" Margin="0,0,8,0" />
                            <Button Content="Importeer SQLite → MongoDB" Command="{Binding ImportSqliteToMongoCommand}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="Gray" Margin="0,8,0,0"
                                   Text="Lokale voorkeuren en export-map blijven in user-settings.json onder %LocalAppData%\DesignGuard\." />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Visibility="{Binding NavSection, Converter={StaticResource IntEqVis}, ConverterParameter=10}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="App security review" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,16"
                                   Text="Interne engineering-checklist (geen pentest). Gebruik als werklijst voor hardening van deze app en vergelijkbare desktop-tools." />
                        <ItemsControl ItemsSource="{Binding AppSecurityReviewRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="#FAFAFA">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Domain}" FontWeight="SemiBold" FontSize="11" Foreground="#4A5568" />
                                            <TextBlock Text="{Binding Item}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="Gray" TextWrapping="Wrap">
                                                <Run Text="Status: " /><Run Text="{Binding Status, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,2,0,0" FontSize="10" TextWrapping="Wrap"><Run Text="Rationale: " /><Run Text="{Binding Rationale, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Margin="0,2,0,0" FontSize="10" TextWrapping="Wrap"><Run Text="Aanbeveling: " /><Run Text="{Binding Recommendation, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="#2B6CB0" TextWrapping="Wrap"><Run Text="Bron-tag: " /><Run Text="{Binding SourceTag, Mode=OneWay}" /></TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Inspector -->
            <ScrollViewer Grid.Column="2" Margin="{DynamicResource DgThickness.PageMargin}" Padding="4,0,0,0">
                <StackPanel>
                    <TextBlock Text="Details" Style="{StaticResource DgText.Title}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource DgText.Muted}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Context voor het geselecteerde item. Suggesties hieronder komen uit je ontwerp (geen automatische goedkeuring)." />
                    <TextBlock Text="Suggesties" Style="{StaticResource DgText.SectionLabel}" />
                    <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DgCard}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Because}" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <Button Content="Negeren" HorizontalAlignment="Left" Margin="0,6,0,0" FontSize="11"
                                                Command="{Binding DataContext.DismissSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Visibility="{Binding ShowProjectOverviewInDetails, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource DgCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Geen selectie" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EditorProjectName}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource DgBrush.TextSecondary}" />
                            <TextBlock Text="Klik op een component in het diagram of kies een dreiging of eis in de lijst."
                                       Style="{StaticResource DgText.Muted}" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Visibility="{Binding SelectedThreat, Converter={StaticResource NotNullToVisibility}}" Style="{StaticResource DgCard}" Margin="0,0,0,8">
                        <StackPanel DataContext="{Binding SelectedThreat}">
                            <TextBlock Text="Dreiging" FontWeight="SemiBold" />
                            <TextBlock Text="Titel" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="28" />
                            <TextBlock Text="Beschrijving" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Height="72" />
                            <TextBlock Text="Notities (voor jouw team)" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="40" />
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding DataContext.DetailLevel, Converter={StaticResource StrEqVis}, ConverterParameter=Beginner, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock Text="In het kort" FontWeight="SemiBold" FontSize="11" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource DgBrush.TextSecondary}"
                                           Text="{Binding Explanation.WhatItMeans, Mode=OneWay}" />
                                <TextBlock Text="Waarom dit telt" FontWeight="SemiBold" FontSize="11" Margin="0,8,0,0" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource DgBrush.TextSecondary}"
                                           Text="{Binding Explanation.WhyItMatters, Mode=OneWay}" />
                                <TextBlock Text="Waarom dit item er staat" FontWeight="SemiBold" FontSize="11" Margin="0,8,0,0" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource DgBrush.TextSecondary}"
                                           Text="{Binding Explanation.WhyIncluded, Mode=OneWay}" />
                            </StackPanel>
                            <Expander Margin="0,12,0,0" Background="Transparent"
                                      IsExpanded="{Binding DataContext.IsAdvancedDetail, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}">
                                <Expander.Header>
                                    <TextBlock Text="Classificatie (STRIDE), triggers &amp; bronverwijzing"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="STRIDE / ernst / status" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}"
                                               ToolTip="STRIDE groepeert soorten aanvallen: Spoofing, Tampering, Repudiation, Information disclosure, Denial of service, Elevation of privilege." />
                                    <ComboBox ItemsSource="{Binding DataContext.AllStrideCategories, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding StrideCategory}" />
                                    <ComboBox Margin="0,4,0,0"
                                              ItemsSource="{Binding DataContext.AllSeverities, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Severity}" />
                                    <ComboBox Margin="0,4,0,0"
                                              ItemsSource="{Binding DataContext.AllThreatStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Status}" />
                                    <TextBlock Text="Triggers (welk ontwerp activeerde dit?)" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <ItemsControl ItemsSource="{Binding TriggerKeys}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" Margin="0,2,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <CheckBox Content="Behoud bij opnieuw genereren (handmatig aangepast)" IsChecked="{Binding UserModified}" Margin="0,8,0,0" />
                                    <TextBlock Text="Voorgestelde mitigaties" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <ItemsControl ItemsSource="{Binding SuggestedMitigations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="11" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Bron (knowledge pack)" FontWeight="SemiBold" Margin="0,12,0,4" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11">
                                        <Run Text="Pack: " /><Run Text="{Binding SourceAttribution.KnowledgePackDisplayLabel, Mode=OneWay}" />
                                        <Run Text=" (" /><Run Text="{Binding SourceAttribution.KnowledgePackVersionLabel, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding SourceAttribution.GuidanceItemIds}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,4" Padding="4,2" Background="{DynamicResource DgBrush.AccentMuted}" CornerRadius="2">
                                                    <TextBlock Text="{Binding}" FontSize="10" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource DgBrush.TextMuted}" TextWrapping="Wrap">
                                        <Run Text="Aard: " /><Run Text="{Binding SourceAttribution.Nature, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Expander>
                            <Button Content="Verwijder dreiging" Style="{StaticResource DgButton.Toolbar}" Margin="0,12,0,0"
                                    Command="{Binding DataContext.RemoveThreatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Border>
                    <Border Visibility="{Binding SelectedRequirement, Converter={StaticResource NotNullToVisibility}}" Style="{StaticResource DgCard}" Margin="0,0,0,8">
                        <StackPanel DataContext="{Binding SelectedRequirement}">
                            <TextBlock Text="Eis" FontWeight="SemiBold" />
                            <TextBlock Text="Titel" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" />
                            <TextBlock Text="Categorie" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                            <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Prioriteit / status" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                            <ComboBox ItemsSource="{Binding DataContext.AllRequirementPriorities, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Priority}" />
                            <ComboBox Margin="0,4,0,0"
                                      ItemsSource="{Binding DataContext.AllRequirementStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Status}" />
                            <TextBlock Text="Uitleg in gewone taal" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                            <TextBox Text="{Binding PlainExplanation, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Height="60" />
                            <TextBlock Text="Waarom dit voor jouw systeem geldt" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                            <TextBox Text="{Binding WhyApplies, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Height="48" />
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding DataContext.DetailLevel, Converter={StaticResource StrEqVis}, ConverterParameter=Beginner, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock Text="Extra samenvatting" FontWeight="SemiBold" FontSize="11" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource DgBrush.TextSecondary}"
                                           Text="{Binding Explanation.WhatItMeans, Mode=OneWay}" />
                            </StackPanel>
                            <Expander Margin="0,12,0,0" Background="Transparent"
                                      IsExpanded="{Binding DataContext.IsAdvancedDetail, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}">
                                <Expander.Header>
                                    <TextBlock Text="Tags, bronverwijzing &amp; technische details" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="Bron-tags" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                                    <ItemsControl ItemsSource="{Binding SourceTags}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,2,0,0" Padding="4,2" Background="{DynamicResource DgBrush.AccentMuted}" HorizontalAlignment="Left" CornerRadius="2">
                                                    <TextBlock Text="{Binding}" FontSize="10" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Bron (knowledge pack)" FontWeight="SemiBold" Margin="0,12,0,4" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11">
                                        <Run Text="Pack: " /><Run Text="{Binding SourceAttribution.KnowledgePackDisplayLabel, Mode=OneWay}" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding SourceAttribution.GuidanceItemIds}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,4" Padding="4,2" Background="{DynamicResource DgBrush.AccentMuted}" CornerRadius="2">
                                                    <TextBlock Text="{Binding}" FontSize="10" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource DgBrush.TextMuted}" TextWrapping="Wrap">
                                        <Run Text="Aard: " /><Run Text="{Binding SourceAttribution.Nature, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Expander>
                            <CheckBox Content="Behoud bij opnieuw genereren" IsChecked="{Binding UserModified}" Margin="0,8,0,0" />
                            <Button Content="Verwijder eis" Style="{StaticResource DgButton.Toolbar}" Margin="0,12,0,0"
                                    Command="{Binding DataContext.RemoveRequirementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Border>
                    <Border Visibility="{Binding SelectedComponent, Converter={StaticResource NotNullToVisibility}}" Style="{StaticResource DgCard}">
                        <StackPanel DataContext="{Binding SelectedComponent}">
                            <TextBlock Text="Component" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Tag}" Foreground="Gray" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="Diagrampositie (optioneel)" FontWeight="SemiBold" Margin="0,12,0,4" FontSize="11" Foreground="Gray" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="X" FontSize="10" Foreground="Gray" />
                                    <TextBox Text="{Binding VisualX, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Y" FontSize="10" Foreground="Gray" />
                                    <TextBox Text="{Binding VisualY, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <Button Content="Diagram bijwerken (posities)" Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Command="{Binding DataContext.RefreshDiagramLayoutCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.ColumnSpan="3" Panel.ZIndex="200"
                    Background="{DynamicResource DgBrush.OverlayScrim}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                    IsHitTestVisible="True">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="24">
                    <ProgressBar IsIndeterminate="True" Height="4" />
                    <TextBlock Text="{Binding BusyMessage}" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="13" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
