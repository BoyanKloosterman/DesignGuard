<Window x:Class="DesignGuard.ProjectWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project wizard — DesignGuard"
        Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuleren" Width="100" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
            <Button Content="Toepassen" Width="100" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Project wizard" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,16"
                           Text="Vul de belangrijkste context in. Dit helpt dreigingen en eisen te verklaren. Geen compliance-claim." />

                <TextBlock Text="Projectnaam *" FontWeight="SemiBold" />
                <TextBox x:Name="ProjName" Margin="0,4,0,12" />

                <TextBlock Text="Korte beschrijving" FontWeight="SemiBold" />
                <TextBox x:Name="ProjDesc" Height="64" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,12" />

                <TextBlock Text="Systeemnaam" FontWeight="SemiBold" />
                <TextBox x:Name="SysName" Margin="0,4,0,12" />

                <TextBlock Text="Systeemtype" FontWeight="SemiBold" />
                <ComboBox x:Name="SysType" Margin="0,4,0,12" />

                <TextBlock Text="Deployment-context" FontWeight="SemiBold" />
                <ComboBox x:Name="DeployCtx" Margin="0,4,0,12" />

                <CheckBox x:Name="ChkInternet" Content="Bereikbaar vanaf internet (publiek / remote)" Margin="0,0,0,8" />
                <CheckBox x:Name="ChkLog" Content="Logging en monitoring aanwezig" Margin="0,0,0,8" />
                <CheckBox x:Name="ChkCritical" Content="Bedrijfskritische functionaliteit" Margin="0,0,0,12" />

                <TextBlock Text="Scope" FontWeight="SemiBold" Margin="0,8,0,4" />
                <CheckBox x:Name="ChkPersonal" Content="Persoonsgegevens" Margin="0,0,0,4" />
                <CheckBox x:Name="ChkAuth" Content="Authenticatie" Margin="0,0,0,4" />
                <CheckBox x:Name="ChkAdmin" Content="Admin / beheer" Margin="0,0,0,4" />
                <CheckBox x:Name="ChkExt" Content="Externe integraties / API's" Margin="0,0,0,4" />
                <CheckBox x:Name="ChkUpload" Content="Bestandsupload" Margin="0,0,0,4" />
                <CheckBox x:Name="ChkSens" Content="Gevoelige data opgeslagen" Margin="0,0,0,12" />

                <TextBlock Text="Rollen (komma-gescheiden, optioneel)" FontWeight="SemiBold" />
                <TextBox x:Name="RolesQuick" Margin="0,4,0,0"
                         ToolTip="Bv. Klant, Beheerder, Support" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
