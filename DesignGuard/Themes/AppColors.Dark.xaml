<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Color x:Key="DgColor.Window">#FF121820</Color>
    <Color x:Key="DgColor.Surface">#FF1A2230</Color>
    <Color x:Key="DgColor.Sidebar">#FF151C28</Color>
    <Color x:Key="DgColor.Border">#FF2D3A4D</Color>
    <Color x:Key="DgColor.BorderStrong">#FF4A5F7A</Color>
    <Color x:Key="DgColor.TextPrimary">#FFE8EDF4</Color>
    <Color x:Key="DgColor.TextSecondary">#FFB8C2D0</Color>
    <Color x:Key="DgColor.TextMuted">#FF8A97A8</Color>
    <Color x:Key="DgColor.Accent">#FF60A5FA</Color>
    <Color x:Key="DgColor.AccentMuted">#FF243A5C</Color>
    <Color x:Key="DgColor.NavSelected">#FF243447</Color>
    <Color x:Key="DgColor.DiagramCanvas">#FF0F141C</Color>
    <Color x:Key="DgColor.OverlayScrim">#99000000</Color>

    <SolidColorBrush x:Key="DgBrush.Window" Color="{StaticResource DgColor.Window}" />
    <SolidColorBrush x:Key="DgBrush.Surface" Color="{StaticResource DgColor.Surface}" />
    <SolidColorBrush x:Key="DgBrush.Sidebar" Color="{StaticResource DgColor.Sidebar}" />
    <SolidColorBrush x:Key="DgBrush.Border" Color="{StaticResource DgColor.Border}" />
    <SolidColorBrush x:Key="DgBrush.BorderStrong" Color="{StaticResource DgColor.BorderStrong}" />
    <SolidColorBrush x:Key="DgBrush.TextPrimary" Color="{StaticResource DgColor.TextPrimary}" />
    <SolidColorBrush x:Key="DgBrush.TextSecondary" Color="{StaticResource DgColor.TextSecondary}" />
    <SolidColorBrush x:Key="DgBrush.TextMuted" Color="{StaticResource DgColor.TextMuted}" />
    <SolidColorBrush x:Key="DgBrush.Accent" Color="{StaticResource DgColor.Accent}" />
    <SolidColorBrush x:Key="DgBrush.AccentMuted" Color="{StaticResource DgColor.AccentMuted}" />
    <SolidColorBrush x:Key="DgBrush.NavSelected" Color="{StaticResource DgColor.NavSelected}" />
    <SolidColorBrush x:Key="DgBrush.DiagramCanvas" Color="{StaticResource DgColor.DiagramCanvas}" />
    <SolidColorBrush x:Key="DgBrush.OverlayScrim" Color="{StaticResource DgColor.OverlayScrim}" />

    <Thickness x:Key="DgThickness.PageMargin">20,16,20,16</Thickness>
    <Thickness x:Key="DgThickness.CardPadding">14,12,14,12</Thickness>
    <Thickness x:Key="DgThickness.SidebarPad">12,14,10,14</Thickness>
    <sys:Double x:Key="DgFontSize.Title">22</sys:Double>
    <sys:Double x:Key="DgFontSize.Subtitle">13</sys:Double>
</ResourceDictionary>
