<UserControl x:Class="DesignGuard.Views.ArchitectureDiagramPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="700"
             x:Name="RootPanel">
    <StackPanel>
        <WrapPanel Margin="0,0,0,8">
            <Button Content="Zoom −" Style="{StaticResource DgButton.Toolbar}" Command="{Binding DiagramZoomOutCommand}" />
            <Button Content="100%" Style="{StaticResource DgButton.Toolbar}" Command="{Binding DiagramFitToScreenCommand}" />
            <Button Content="Zoom +" Style="{StaticResource DgButton.Toolbar}" Command="{Binding DiagramZoomInCommand}" />
            <CheckBox Content="Raster" IsChecked="{Binding DiagramShowGrid}" VerticalAlignment="Center" Margin="0,0,12,6" />
            <CheckBox Content="Trust boundaries" IsChecked="{Binding DiagramOverlayTrustBoundaries}" VerticalAlignment="Center" Margin="0,0,12,6" />
            <CheckBox Content="Gevoelige data" IsChecked="{Binding DiagramOverlaySensitiveData}" VerticalAlignment="Center" Margin="0,0,12,6" />
            <CheckBox Content="Dreiging → component" IsChecked="{Binding DiagramOverlayThreatLinks}" VerticalAlignment="Center" Margin="0,0,12,6"
                      Visibility="{Binding ShowThreatLinkCheckbox, ElementName=RootPanel, Converter={StaticResource BoolToVis}}" />
            <Button Content="Herschik automatisch" Style="{StaticResource DgButton.Toolbar}" Command="{Binding ResetDiagramPositionsCommand}"
                    ToolTip="Wist handmatige posities en laat alles automatisch neerzetten" />
        </WrapPanel>
        <Border BorderBrush="{DynamicResource DgBrush.Border}" BorderThickness="1" Height="420"
                Background="{DynamicResource DgBrush.DiagramCanvas}" CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DiagramShowGrid}" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute" Opacity="0.5">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <LineGeometry StartPoint="0,22" EndPoint="22,0" />
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="{DynamicResource DgBrush.Border}" Thickness="0.6" />
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="DiagramGrid" Width="{Binding DiagramContentWidth}" Height="{Binding DiagramContentHeight}"
                      Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding DiagramZoom}" ScaleY="{Binding DiagramZoom}" />
                    </Grid.LayoutTransform>
                    <ItemsControl ItemsSource="{Binding DiagramTrustOverlays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="10" BorderThickness="2"
                                        BorderBrush="{Binding Color}" Background="#08FFFFFF" SnapsToDevicePixels="True" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Lijnen onder knopen; labels erboven (na nudge uit nodes) -->
                    <ItemsControl ItemsSource="{Binding DiagramLines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="0" />
                                <Setter Property="Canvas.Top" Value="0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Path Data="{Binding CurvePath}" Stroke="{DynamicResource DgBrush.DiagramEdge}" StrokeThickness="1"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Fill="Transparent" SnapsToDevicePixels="True" Opacity="0.92" />
                                    <Path Data="{Binding ArrowPath}" Fill="{DynamicResource DgBrush.DiagramArrowFill}" Stroke="{DynamicResource DgBrush.DiagramArrowStroke}" StrokeThickness="0.35"
                                          StrokeLineJoin="Miter" SnapsToDevicePixels="True" />
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding DiagramNodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="196" Height="64" CornerRadius="8" BorderThickness="1.5" Padding="8,6,8,6"
                                        Background="{DynamicResource DgBrush.DiagramNodeFill}" SnapsToDevicePixels="True"
                                        Cursor="SizeAll"
                                        MouseLeftButtonDown="DiagramNode_MouseDown"
                                        MouseMove="DiagramNode_MouseMove"
                                        MouseLeftButtonUp="DiagramNode_MouseUp"
                                        LostMouseCapture="DiagramNode_LostCapture">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource DgBrush.DiagramNodeBorder}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#C53030" />
                                                    <Setter Property="BorderThickness" Value="2.5" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLinkedHighlight}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#B83280" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Tag>
                                        <Binding Path="ComponentId" />
                                    </Border.Tag>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="2,0,0,2" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#CBD5E1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowSensitiveStripe}" Value="True">
                                                            <Setter Property="Background" Value="#D69E2E" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEntryPoint}" Value="True">
                                                            <Setter Property="Background" Value="#38A169" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DgBrush.TextPrimary}" />
                                            <TextBlock Text="{Binding Tag}" Foreground="{DynamicResource DgBrush.TextMuted}" FontSize="10" />
                                            <TextBlock Text="{Binding DataSensitivity}" FontSize="9" Foreground="{DynamicResource DgBrush.TextSecondary}" Visibility="{Binding ShowSensitiveStripe, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding DiagramLines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="0" />
                                <Setter Property="Canvas.Top" Value="0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Border Canvas.Left="{Binding LabelDrawLeft}" Canvas.Top="{Binding LabelDrawTop}"
                                            Background="{DynamicResource DgBrush.DiagramLabelBg}" BorderBrush="{DynamicResource DgBrush.Border}" BorderThickness="1"
                                            CornerRadius="3" Padding="4,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Label}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource DgBrush.TextPrimary}"
                                                   TextWrapping="Wrap" MaxWidth="200" />
                                    </Border>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Border>
        <Button Content="Diagram verversen" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding RefreshDiagramLayoutCommand}" />
    </StackPanel>
</UserControl>
