<UserControl x:Class="DesignGuard.Views.ArchitectureDiagramPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar: model-naar-Mermaid regeneratie en reset -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="Regenereer uit model" Style="{StaticResource DgButton.Toolbar}" Command="{Binding RefreshDiagramLayoutCommand}"
                    ToolTip="Bouwt de Mermaid-code opnieuw op basis van componenten, trust boundaries en data flows" />
            <Button Content="Reset Mermaid" Style="{StaticResource DgButton.Toolbar}" Command="{Binding ResetDiagramPositionsCommand}"
                    ToolTip="Gooit eventuele handmatige aanpassingen weg en rebuild van model" />
        </WrapPanel>

        <!-- Editor (links) + live preview in WebView2 (rechts) -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource DgBrush.Border}" BorderThickness="1" CornerRadius="8"
                Background="{DynamicResource DgBrush.DiagramCanvas}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="220" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="2*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Mermaid-code" Style="{StaticResource DgText.SectionLabel}" Margin="8,6,8,4" />
                    <TextBox x:Name="EditorTextBox" Grid.Row="1"
                             Margin="6,0,6,6"
                             FontFamily="Consolas"
                             FontSize="12"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             SpellCheck.IsEnabled="False"
                             Text="{Binding MermaidCode, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              Background="{DynamicResource DgBrush.Border}" ResizeBehavior="PreviousAndNext" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Live preview" Style="{StaticResource DgText.SectionLabel}" Margin="8,6,8,4" />
                    <Border Grid.Row="1" Margin="6,0,6,6" BorderBrush="{DynamicResource DgBrush.Border}" BorderThickness="1" CornerRadius="4"
                            Background="#FFFFFFFF">
                        <wv2:WebView2 x:Name="PreviewWebView" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Syntax-fouten uit Mermaid.js worden hier getoond -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,6" CornerRadius="6"
                Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                Visibility="{Binding HasMermaidError, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Syntaxfout in Mermaid" FontWeight="SemiBold" Foreground="#B91C1C" />
                <TextBlock Text="{Binding MermaidSyntaxError}" TextWrapping="Wrap" Foreground="#991B1B" FontFamily="Consolas" FontSize="11" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
