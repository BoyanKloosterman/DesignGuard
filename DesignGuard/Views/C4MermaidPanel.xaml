<UserControl x:Class="DesignGuard.Views.C4MermaidPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <ComboBox Width="220" Margin="0,0,12,0" VerticalAlignment="Center"
                      ItemsSource="{Binding C4MermaidBandOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Band"
                      SelectedValue="{Binding C4MermaidBand}" />
            <Button Content="Vernieuw uit C4-tabel" Style="{StaticResource DgButton.Toolbar}" Command="{Binding RefreshC4MermaidDiagramCommand}"
                    ToolTip="Genereert Mermaid C4-code op basis van de onderstaande rijen (niveau, parent id, enz.)" />
        </WrapPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource DgBrush.Border}" BorderThickness="1" CornerRadius="8"
                Background="{DynamicResource DgBrush.DiagramCanvas}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="200" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="2*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Mermaid C4" Style="{StaticResource DgText.SectionLabel}" Margin="8,6,8,4" />
                    <TextBox Grid.Row="1" Margin="6,0,6,6" FontFamily="Consolas" FontSize="11"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             SpellCheck.IsEnabled="False"
                             Text="{Binding C4MermaidCode, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              Background="{DynamicResource DgBrush.Border}" ResizeBehavior="PreviousAndNext" />

                <Grid Grid.Column="2" MinHeight="360">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="320" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource DgText.SectionLabel}" Margin="8,6,8,4"
                               Text="Live preview (C4-stijl)"
                               ToolTip="Sleep met de muis in het witte vlak om het diagram te verschuiven (pannen). Scrollwiel blijft ook werken." />
                    <Border Grid.Row="1" Margin="6,0,6,6" BorderBrush="{DynamicResource DgBrush.Border}" BorderThickness="1" CornerRadius="4"
                            Background="#FFFFFFFF" MinHeight="300">
                        <wv2:WebView2 x:Name="PreviewWebView" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,6" CornerRadius="6"
                Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                Visibility="{Binding HasC4MermaidError, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Mermaid C4-fout" FontWeight="SemiBold" Foreground="#B91C1C" />
                <TextBlock Text="{Binding C4MermaidSyntaxError}" TextWrapping="Wrap" Foreground="#991B1B" FontFamily="Consolas" FontSize="11" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
