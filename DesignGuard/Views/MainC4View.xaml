<UserControl x:Class="DesignGuard.Views.MainC4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:DesignGuard.Views"
             xmlns:dg="clr-namespace:DesignGuard"
             xmlns:ui="clr-namespace:DesignGuard.Ui"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <DockPanel Visibility="{Binding NavSection, Converter={StaticResource NavSectionVis}, ConverterParameter={x:Static dg:MainNavSection.C4Model}}">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="C4-model" Style="{StaticResource DgText.Title}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource DgText.Muted}" FontSize="11" TextWrapping="Wrap"
                       Text="{x:Static ui:UiHelpTexts.C4PanelSummary}"
                       ToolTip="{x:Static ui:UiHelpTexts.C4TooltipBody}" />
            <WrapPanel Margin="0,8,0,0">
                <Button Content="Analyse vernieuwen" Command="{Binding RegenerateFromDesignCommand}" Style="{StaticResource DgButton.Toolbar}" Margin="0,0,8,8" />
                <Button Content="C4-rij toevoegen" Command="{Binding AddC4ElementCommand}" Style="{StaticResource DgButton.Toolbar}" Margin="0,0,8,8" />
                <Button Content="C4-rij verwijderen" Command="{Binding RemoveC4ElementCommand}" CommandParameter="{Binding SelectedC4Element}"
                        Style="{StaticResource DgButton.Toolbar}" Margin="0,0,8,8" />
                <Button Content="Relatie toevoegen" Command="{Binding AddC4RelationCommand}" Style="{StaticResource DgButton.Toolbar}" Margin="0,0,8,8" />
                <Button Content="Relatie verwijderen" Command="{Binding RemoveC4RelationCommand}" CommandParameter="{Binding SelectedC4Relation}"
                        Style="{StaticResource DgButton.Toolbar}" Margin="0,0,8,8" />
            </WrapPanel>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3.2*" MinHeight="300" />
                <RowDefinition Height="2*" MinHeight="120" />
                <RowDefinition Height="1.4*" MinHeight="96" />
            </Grid.RowDefinitions>
            <views:C4MermaidPanel Grid.Row="0" Margin="0,0,0,10" MinHeight="280" />
            <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Top" Text="C4-elementen (tabel)" Style="{StaticResource DgText.SectionLabel}" Margin="0,0,0,6" />
                <DataGrid x:Name="C4Grid" ItemsSource="{Binding C4Elements}" SelectedItem="{Binding SelectedC4Element}"
                          AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Single" GridLinesVisibility="Horizontal"
                          CellEditEnding="C4Grid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Niveau" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LevelLabel}" VerticalAlignment="Center" Margin="4,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.C4LevelChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Level, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Naam" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridTextColumn Header="Omschrijving" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                        <DataGridTextColumn Header="Tech / notitie" Binding="{Binding Technology, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridTemplateColumn Header="Ouder" Width="240" MinWidth="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding ParentPickOptions}"
                                              SelectedItem="{Binding SelectedParentPick, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Label"
                                              SelectionChanged="C4ParentCombo_SelectionChanged"
                                              MinWidth="140" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Open dreig." Binding="{Binding LinkedOpenThreatCount, Mode=OneWay}" IsReadOnly="True" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="C4-relaties (Mermaid Rel)" Style="{StaticResource DgText.SectionLabel}" Margin="0,8,0,6" />
                <DataGrid x:Name="C4RelationsGrid" ItemsSource="{Binding C4Relations}" SelectedItem="{Binding SelectedC4Relation}"
                          AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Single" GridLinesVisibility="Horizontal"
                          CellEditEnding="C4RelationsGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Van" Width="2*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.C4RelationEndpointChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding SelectedFromEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Label"
                                              SelectionChanged="C4RelationEndpointCombo_SelectionChanged"
                                              MinWidth="160" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Naar" Width="2*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.C4RelationEndpointChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding SelectedToEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Label"
                                              SelectionChanged="C4RelationEndpointCombo_SelectionChanged"
                                              MinWidth="160" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
