<UserControl x:Class="DesignGuard.Views.MainDesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:DesignGuard.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="900">
    <ScrollViewer AutomationProperties.AutomationId="OntwerpDesignScroll"
                  Visibility="{Binding NavSection, Converter={StaticResource IntEqVis}, ConverterParameter=1}"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Systeemontwerp" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
            <GroupBox Header="Project">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Naam" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding EditorProjectName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="Beschrijving" Margin="0,8,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Height="56" TextWrapping="Wrap" AcceptsReturn="True"
                             Text="{Binding EditorProjectDescription, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </GroupBox>
            <GroupBox Header="Governance en organisatie" Margin="0,8,0,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Security-eigenaar" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding EditorGovernanceSecurityOwner, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="Technische eigenaar" Margin="0,8,0,0" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                             Text="{Binding EditorGovernanceTechnicalOwner, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Text="Compliance / privacy" Margin="0,8,0,0" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                             Text="{Binding EditorGovernanceComplianceStakeholder, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" Text="Reviewritme" Margin="0,8,0,0" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"
                             Text="{Binding EditorGovernanceReviewCadence, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </GroupBox>
            <GroupBox Header="Systeemcontext" Margin="0,8,0,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Systeemnaam" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding EditorSystemName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="Type" Margin="0,8,0,0" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                              ItemsSource="{Binding SystemTypeOptions}" SelectedItem="{Binding EditorSystemType}" />
                    <TextBlock Grid.Row="2" Text="Deployment" Margin="0,8,0,0" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                              ItemsSource="{Binding DeploymentContextOptions}" SelectedItem="{Binding EditorDeploymentContext}" />
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
                        <CheckBox Content="Internetblootstelling" IsChecked="{Binding FlagInternetExposed}" />
                        <CheckBox Content="Logging / monitoring aanwezig" IsChecked="{Binding FlagLoggingMonitoring}" />
                        <CheckBox Content="Bedrijfskritisch" IsChecked="{Binding FlagCriticalBusiness}" />
                        <CheckBox Content="Persoonsgegevens" IsChecked="{Binding FlagPersonalData}" />
                        <CheckBox Content="Authenticatie" IsChecked="{Binding FlagAuth}" />
                        <CheckBox Content="Adminfunctionaliteit" IsChecked="{Binding FlagAdmin}" />
                        <CheckBox Content="Externe API's" IsChecked="{Binding FlagExternalApi}" />
                        <CheckBox Content="Bestandsupload" IsChecked="{Binding FlagUpload}" />
                        <CheckBox Content="Gevoelige opslag" IsChecked="{Binding FlagSensitiveStorage}" />
                    </StackPanel>
                </Grid>
            </GroupBox>
            <GroupBox Header="Trust boundaries" Margin="0,8,0,0">
                <StackPanel Margin="8">
                    <Button Content="Toevoegen" HorizontalAlignment="Left" Command="{Binding AddTrustBoundaryCommand}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding TrustBoundaries}" AutoGenerateColumns="False" CanUserAddRows="False" Height="120"
                              HeadersVisibility="Column" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Naam" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Omschrijving" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            <DataGridTextColumn Header="Kleur" Binding="{Binding ColorHint, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Verwijder"
                                                Command="{Binding DataContext.RemoveTrustBoundaryCommand, RelativeSource={RelativeSource AncestorType={x:Type views:MainDesignView}}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Componenten" Margin="0,8,0,0">
                <StackPanel Margin="8">
                    <TextBlock Margin="0,0,0,6" Style="{StaticResource DgText.Muted}" FontSize="11" TextWrapping="Wrap"
                               Text="Entry: vink aan voor ingangen (geen aparte entry-lijst meer)." />
                    <Button Content="Component toevoegen" HorizontalAlignment="Left" Command="{Binding AddComponentCommand}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent}" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Height="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Naam" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTemplateColumn Header="Tag" Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" StaysOpenOnEdit="False"
                                                  ItemsSource="{Binding DataContext.ComponentTagSuggestions, RelativeSource={RelativeSource AncestorType={x:Type views:MainDesignView}}}"
                                                  Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Classificatie alleen bij Assets (geen dubbele invoer met componenten). -->
                            <DataGridCheckBoxColumn Header="Entry" Binding="{Binding IsEntryPoint}" Width="50" />
                            <DataGridTextColumn Header="Boundary (naam)" Binding="{Binding TrustBoundaryName, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                            <DataGridTemplateColumn Header="Data" Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" StaysOpenOnEdit="False"
                                                  ItemsSource="{Binding DataContext.PresetDataSensitivityLabels, RelativeSource={RelativeSource AncestorType={x:Type views:MainDesignView}}}"
                                                  Text="{Binding DataSensitivity, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Notities" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Verwijder"
                                                Command="{Binding DataContext.RemoveComponentCommand, RelativeSource={RelativeSource AncestorType={x:Type views:MainDesignView}}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Datastromen" Margin="0,8,0,0">
                <StackPanel Margin="8">
                    <Button Content="Stroom toevoegen" HorizontalAlignment="Left" Command="{Binding AddDataFlowCommand}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding DataFlows}" AutoGenerateColumns="False" CanUserAddRows="False" Height="140"
                              HeadersVisibility="Column" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Van" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Components, RelativeSource={RelativeSource AncestorType={x:Type views:MainDesignView}}}"
                                                  SelectedItem="{Binding From, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Naar" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Components, RelativeSource={RelativeSource AncestorType={x:Type views:MainDesignView}}}"
                                                  SelectedItem="{Binding To, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Verwijder"
                                                Command="{Binding DataContext.RemoveDataFlowCommand, RelativeSource={RelativeSource AncestorType={x:Type views:MainDesignView}}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Rollen" Margin="0,8,0,0">
                <StackPanel Margin="8">
                    <Button Content="Rol toevoegen" HorizontalAlignment="Left" Command="{Binding AddRoleCommand}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Roles}" AutoGenerateColumns="False" CanUserAddRows="False" Height="100"
                              HeadersVisibility="Column" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Naam" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Omschrijving" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Verwijder"
                                                Command="{Binding DataContext.RemoveRoleCommand, RelativeSource={RelativeSource AncestorType={x:Type views:MainDesignView}}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Assets" Margin="0,8,0,0">
                <StackPanel Margin="8">
                    <Button Content="Asset toevoegen" Command="{Binding AddAssetCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Assets}" AutoGenerateColumns="False" CanUserAddRows="False" Height="140"
                              HeadersVisibility="Column" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Naam" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTemplateColumn Header="Classificatie" Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" StaysOpenOnEdit="False"
                                                  ItemsSource="{Binding DataContext.PresetAssetClassifications, RelativeSource={RelativeSource AncestorType={x:Type views:MainDesignView}}}"
                                                  Text="{Binding Classification, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Gevoeligheid" Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" StaysOpenOnEdit="False"
                                                  ItemsSource="{Binding DataContext.PresetDataSensitivityLabels, RelativeSource={RelativeSource AncestorType={x:Type views:MainDesignView}}}"
                                                  Text="{Binding Sensitivity, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Componenten" Width="260" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ToggleButton x:Name="AssetCompPickToggle"
                                                          Style="{StaticResource DgToggle.ComboLike}"
                                                          HorizontalContentAlignment="Left"
                                                          Content="{Binding LinkedComponentsDisplay}"
                                                          ToolTip="{Binding LinkedComponentsDisplay}" />
                                            <Popup IsOpen="{Binding IsChecked, ElementName=AssetCompPickToggle, Mode=TwoWay}"
                                                   PlacementTarget="{Binding ElementName=AssetCompPickToggle}"
                                                   Placement="Bottom" StaysOpen="False" Focusable="False">
                                                <Border MinWidth="280" MaxHeight="260" Padding="6"
                                                        Background="{DynamicResource DgBrush.InputBackground}"
                                                        BorderBrush="{DynamicResource DgBrush.InputBorder}"
                                                        BorderThickness="1" SnapsToDevicePixels="True">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                                        <ItemsControl ItemsSource="{Binding ComponentPicks}" Focusable="False">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox Margin="0,4" Focusable="True"
                                                                              Content="{Binding Component.Name}"
                                                                              IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Verwijder" Command="{Binding DataContext.RemoveAssetCommand, RelativeSource={RelativeSource AncestorType={x:Type views:MainDesignView}}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Gevoelige data (categorie)" Margin="0,8,0,0">
                <StackPanel Margin="8">
                    <Button Content="Rij toevoegen" Command="{Binding AddSensitiveDataRowCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding SensitiveDataRows}" AutoGenerateColumns="False" CanUserAddRows="False" Height="100"
                              HeadersVisibility="Column" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Naam" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Categorie" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <DataGridTextColumn Header="Opslag" Binding="{Binding StorageLocation, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTemplateColumn Header="Component" Width="140" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Components, RelativeSource={RelativeSource AncestorType={x:Type views:MainDesignView}}}"
                                                  SelectedItem="{Binding RelatedComponent, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Verwijder" Command="{Binding DataContext.RemoveSensitiveDataRowCommand, RelativeSource={RelativeSource AncestorType={x:Type views:MainDesignView}}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Architectuurdiagram" Margin="0,8,0,0">
                <StackPanel Margin="8">
                    <TextBlock Margin="0,0,0,6" Style="{StaticResource DgText.Muted}" FontSize="11" TextWrapping="Wrap"
                               Text="Tip: groene rand = ingang, oranje streep = gevoelige data. Trust boundary = vertrouwensgrens (bijv. internet vs intern). Dit canvas is je architectuurdiagram. Tab Threatmodel bevat een apart C4-overzicht (context t/m code): werk beide bewust bij — het canvas voor de tekening, C4 voor abstractielagen en om dreigingen via exact dezelfde componentnaam te koppelen." />
                    <views:ArchitectureDiagramPanel ShowThreatLinkCheckbox="True" />
                    <Button Content="Analyse vernieuwen (dreigingen/eisen)" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding RegenerateFromDesignCommand}" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
