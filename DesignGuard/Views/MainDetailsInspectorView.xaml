<UserControl x:Class="DesignGuard.Views.MainDetailsInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="328">
    <UserControl.Resources>
        <!-- Rij-volgorde: tab Eisen (NavSection 4) = eis boven dreiging; anders dreiging eerst. -->
        <Style x:Key="DetailThreatCardOrdered" TargetType="Border" BasedOn="{StaticResource DgCard}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Grid.Row" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NavSection}" Value="4">
                    <Setter Property="Grid.Row" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetailRequirementCardOrdered" TargetType="Border" BasedOn="{StaticResource DgCard}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Grid.Row" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NavSection}" Value="4">
                    <Setter Property="Grid.Row" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer Margin="{DynamicResource DgThickness.PageMargin}" Padding="4,0,0,0">
        <StackPanel>
            <TextBlock Text="Details" Style="{StaticResource DgText.Title}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource DgText.Muted}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"
                       Text="Eerst het geselecteerde item; suggesties staan onderaan (uit je ontwerp, geen automatische goedkeuring)." />
            <Border Visibility="{Binding ShowProjectOverviewInDetails, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource DgCard}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Geen selectie" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding EditorProjectName}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource DgBrush.TextSecondary}" />
                    <TextBlock Text="Klik op een component in het diagram of kies een dreiging of eis in de lijst."
                               Style="{StaticResource DgText.Muted}" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Grid Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <Border Visibility="{Binding SelectedThreat, Converter={StaticResource NotNullToVisibility}}" Style="{StaticResource DetailThreatCardOrdered}">
                <StackPanel DataContext="{Binding SelectedThreat}">
                    <TextBlock Text="Dreiging" FontWeight="SemiBold" />
                    <TextBlock Text="Titel" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="28" />
                    <TextBlock Text="Beschrijving" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Height="72" />
                    <TextBlock Text="Notities (voor jouw team)" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="40" />
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding DataContext.DetailLevel, Converter={StaticResource StrEqVis}, ConverterParameter=Beginner, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="In het kort" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource DgBrush.TextSecondary}"
                                   Text="{Binding Explanation.WhatItMeans, Mode=OneWay}" />
                        <TextBlock Text="Waarom dit telt" FontWeight="SemiBold" FontSize="11" Margin="0,8,0,0" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource DgBrush.TextSecondary}"
                                   Text="{Binding Explanation.WhyItMatters, Mode=OneWay}" />
                        <TextBlock Text="Waarom dit item er staat" FontWeight="SemiBold" FontSize="11" Margin="0,8,0,0" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource DgBrush.TextSecondary}"
                                   Text="{Binding Explanation.WhyIncluded, Mode=OneWay}" />
                    </StackPanel>
                    <Expander Margin="0,12,0,0" Background="Transparent"
                              IsExpanded="{Binding DataContext.IsAdvancedDetail, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}">
                        <Expander.Header>
                            <TextBlock Text="Classificatie (STRIDE), triggers &amp; bronverwijzing"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="STRIDE / ernst / status" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}"
                                       ToolTip="STRIDE groepeert soorten aanvallen: Spoofing, Tampering, Repudiation, Information disclosure, Denial of service, Elevation of privilege." />
                            <ComboBox ItemsSource="{Binding DataContext.AllStrideCategories, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding StrideCategory}" />
                            <ComboBox Margin="0,4,0,0"
                                      ItemsSource="{Binding DataContext.AllSeverities, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Severity}" />
                            <ComboBox Margin="0,4,0,0"
                                      ItemsSource="{Binding DataContext.AllThreatStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Status}"
                                      GotFocus="ThreatStatusCombo_GotFocus"
                                      DropDownOpened="ThreatStatusCombo_DropDownOpened"
                                      LostFocus="ThreatStatusCombo_LostFocus"
                                      DropDownClosed="ThreatStatusCombo_DropDownClosed" />
                            <TextBlock Text="Status-audit" FontWeight="SemiBold" FontSize="11" Margin="0,10,0,0"
                                       Foreground="{DynamicResource DgBrush.TextMuted}" />
                            <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource DgBrush.TextSecondary}"
                                       TextWrapping="Wrap">
                                <Run Text="Vastgelegd (UTC): " />
                                <Run Text="{Binding StatusChangedAtUtc, Converter={StaticResource UtcDateOrDash}, Mode=OneWay}" />
                                <Run Text=" — door: " />
                                <Run Text="{Binding StatusChangedBy, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="Toelichting bij statuswijziging (optioneel)" FontSize="11"
                                       Foreground="{DynamicResource DgBrush.TextMuted}" Margin="0,8,0,0" />
                            <TextBox Text="{Binding StatusChangeNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                                     MinHeight="44" />
                            <TextBlock Text="Triggers (welk ontwerp activeerde dit?)" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <ItemsControl ItemsSource="{Binding TriggerKeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" Margin="0,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox Content="Behoud bij opnieuw genereren (handmatig aangepast)" IsChecked="{Binding UserModified}" Margin="0,8,0,0" />
                            <TextBlock Text="Voorgestelde mitigaties" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <ItemsControl ItemsSource="{Binding SuggestedMitigations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="11" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Bron (knowledge pack)" FontWeight="SemiBold" Margin="0,12,0,4" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                            <TextBlock TextWrapping="Wrap" FontSize="11">
                                <Run Text="Pack: " /><Run Text="{Binding SourceAttribution.KnowledgePackDisplayLabel, Mode=OneWay}" />
                                <Run Text=" (" /><Run Text="{Binding SourceAttribution.KnowledgePackVersionLabel, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding SourceAttribution.GuidanceItemIds}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,6,4" Padding="4,2" Background="{DynamicResource DgBrush.AccentMuted}" CornerRadius="2">
                                            <TextBlock Text="{Binding}" FontSize="10" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource DgBrush.TextMuted}" TextWrapping="Wrap">
                                <Run Text="Aard: " /><Run Text="{Binding SourceAttribution.Nature, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Expander>
                    <Button Content="Verwijder dreiging" Style="{StaticResource DgButton.Toolbar}" Margin="0,12,0,0"
                            Command="{Binding DataContext.RemoveThreatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
            <Border Visibility="{Binding SelectedRequirement, Converter={StaticResource NotNullToVisibility}}" Style="{StaticResource DetailRequirementCardOrdered}">
                <StackPanel DataContext="{Binding SelectedRequirement}">
                    <TextBlock Text="Eis" FontWeight="SemiBold" />
                    <TextBlock Text="Titel" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" />
                    <TextBlock Text="Categorie" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                    <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Prioriteit / status" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                    <ComboBox ItemsSource="{Binding DataContext.AllRequirementPriorities, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding Priority}" />
                    <ComboBox Margin="0,4,0,0"
                              ItemsSource="{Binding DataContext.AllRequirementStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding Status}" />
                    <TextBlock Text="Uitleg in gewone taal" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                    <TextBox Text="{Binding PlainExplanation, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Height="60" />
                    <TextBlock Text="Waarom dit voor jouw systeem geldt" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                    <TextBox Text="{Binding WhyApplies, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Height="48" />
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding DataContext.DetailLevel, Converter={StaticResource StrEqVis}, ConverterParameter=Beginner, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="Extra samenvatting" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource DgBrush.TextSecondary}"
                                   Text="{Binding Explanation.WhatItMeans, Mode=OneWay}" />
                    </StackPanel>
                    <Expander Margin="0,12,0,0" Background="Transparent"
                              IsExpanded="{Binding DataContext.IsAdvancedDetail, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}">
                        <Expander.Header>
                            <TextBlock Text="Tags, bronverwijzing &amp; technische details" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Bron-tags" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                            <ItemsControl ItemsSource="{Binding SourceTags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2,0,0" Padding="4,2" Background="{DynamicResource DgBrush.AccentMuted}" HorizontalAlignment="Left" CornerRadius="2">
                                            <TextBlock Text="{Binding}" FontSize="10" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Bron (knowledge pack)" FontWeight="SemiBold" Margin="0,12,0,4" FontSize="11" Foreground="{DynamicResource DgBrush.TextMuted}" />
                            <TextBlock TextWrapping="Wrap" FontSize="11">
                                <Run Text="Pack: " /><Run Text="{Binding SourceAttribution.KnowledgePackDisplayLabel, Mode=OneWay}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding SourceAttribution.GuidanceItemIds}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,6,4" Padding="4,2" Background="{DynamicResource DgBrush.AccentMuted}" CornerRadius="2">
                                            <TextBlock Text="{Binding}" FontSize="10" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource DgBrush.TextMuted}" TextWrapping="Wrap">
                                <Run Text="Aard: " /><Run Text="{Binding SourceAttribution.Nature, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Expander>
                    <CheckBox Content="Behoud bij opnieuw genereren" IsChecked="{Binding UserModified}" Margin="0,8,0,0" />
                    <Button Content="Verwijder eis" Style="{StaticResource DgButton.Toolbar}" Margin="0,12,0,0"
                            Command="{Binding DataContext.RemoveRequirementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
            </Grid>
            <Border Visibility="{Binding SelectedComponent, Converter={StaticResource NotNullToVisibility}}" Style="{StaticResource DgCard}">
                <StackPanel DataContext="{Binding SelectedComponent}">
                    <TextBlock Text="Component" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Tag}" Foreground="Gray" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="Diagrampositie (optioneel)" FontWeight="SemiBold" Margin="0,12,0,4" FontSize="11" Foreground="Gray" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="X" FontSize="10" Foreground="Gray" />
                            <TextBox Text="{Binding VisualX, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Y" FontSize="10" Foreground="Gray" />
                            <TextBox Text="{Binding VisualY, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <Button Content="Diagram bijwerken (posities)" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Command="{Binding DataContext.RefreshDiagramLayoutCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </Border>
            <TextBlock Text="Suggesties" Style="{StaticResource DgText.SectionLabel}" Margin="0,16,0,0" />
            <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DgCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Because}" Foreground="{DynamicResource DgBrush.TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <Button Content="Negeren" Style="{StaticResource DgButton.Toolbar}" HorizontalAlignment="Left" Margin="0,6,0,0" FontSize="11"
                                        Command="{Binding DataContext.DismissSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
